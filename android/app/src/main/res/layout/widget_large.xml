<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_large_container" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_widget_card" android:orientation="vertical" android:padding="18dp">
  <TextView android:id="@+id/widget_large_goal_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Goal" android:textColor="#0F172A" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/widget_large_target_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#64748B" android:textSize="11sp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
      <TextView android:id="@+id/widget_large_current_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0d" android:textColor="#2563EB" android:textSize="34sp" android:textStyle="bold"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DAY STREAK" android:textColor="#64748B" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
      <TextView android:id="@+id/widget_large_countdown_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#0F172A" android:textSize="22sp" android:textStyle="bold"/>
      <TextView android:id="@+id/widget_large_countdown_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="days left" android:textColor="#64748B" android:textSize="11sp"/>
    </LinearLayout>
  </LinearLayout>
  <TextView android:id="@+id/widget_large_longest_streak" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
  <TextView android:id="@+id/widget_large_last_checkin" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
  <TextView android:id="@+id/widget_large_missed_days" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
  <TextView android:id="@+id/widget_large_countdown_change" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
  <Button android:id="@+id/btn_widget_large_checkin" android:layout_width="match_parent" android:layout_height="46dp" android:text="Check In" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@drawable/bg_widget_btn_pending"/>
</LinearLayout>
